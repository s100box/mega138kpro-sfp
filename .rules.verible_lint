# Verible lint rule configuration for mega138kpro-sfp (sim/lint.sh passes it
# with --rules_config). Keep this list MINIMAL -- fix the RTL rather than
# waiving; each entry needs a one-line justification.

# Project convention is ALL_CAPS_SNAKE for localparams as well as parameters;
# Verible's default wants CamelCase localparams.
-parameter-name-style

# Block-local temporaries in an always_ff (the word being built, a popcount)
# are assigned with blocking statements before the result is registered with a
# nonblocking one; only assignments to module-level state must be nonblocking.
always-ff-non-blocking=waive_for_locals:true
